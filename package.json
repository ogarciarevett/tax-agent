{
	"name": "tax-agent",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Tax Agent — Financial Intelligence Graph. Pipeline/bootstrap phase; src/ is the frozen Legacy CLI v0 (Spain-only, local-first).",
	"engines": {
		"node": "^24.22.1"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"test:graph": "node scripts/validate-task-graph.test.mjs",
		"graph:validate": "node scripts/validate-task-graph.mjs .ai/specs/task-graphs/*.json",
		"eval": "node scripts/run-evals.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.10.0",
		"@vitest/coverage-v8": "^4.1.9",
		"tsx": "^4.22.4",
		"typescript": "7.0.2",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@opentui/core": "^0.4.2",
		"better-sqlite3": "^12.11.1",
		"zod": "^4.4.3"
	}
}
