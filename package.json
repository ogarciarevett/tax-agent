		"@types/node": "^22.10.0",
		"@vitest/coverage-v8": "^4.1.9",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@opentui/core": "^0.4.2",
		"better-sqlite3": "^12.11.1",
		"zod": "^4.4.3"
	}
}
