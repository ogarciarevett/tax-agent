{
	"name": "tax-agent",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Local-first personal tax agent (Spain first) — opentui interview, on-device storage, daily bill scan, country-correct report.",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
