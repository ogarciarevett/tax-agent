# Local, per-developer agent working log — seeded from .ai/memory.example.md by `sh scripts/sync-ai-docs.sh`.
# Durable decisions go in commits / docs/adr, never here. See .ai/context.md "Memory protocol".
.ai/memory.md

# Secrets — never commit these.
.env
.env.*
!.env.example

# --- Node / TypeScript (added by /bootstrap) ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.pnpm-store/

# Local on-device data — tax documents, RAG/vector store, SQLite DB. NEVER commit (PII).
data/
*.sqlite
*.sqlite-*
*.db

# Generated per-tool agent mirrors — single source of truth is .ai/; these are REGENERATED
# from it by `sh scripts/sync-ai-docs.sh` (run automatically by `sh scripts/install.sh`).
# Kept LOCAL-ONLY so the repo holds no duplicated skill/agent/command copies. After cloning,
# run `sh scripts/install.sh` (or the sync script) or your tools will see zero skills.
# NOTE: the root contract entry files (AGENTS.md, CLAUDE.md, GEMINI.md) stay committed so the
# repo stays readable on GitHub and the contract loads without a build step.
.ai/generated/
.claude/skills/
.claude/agents/
.claude/commands/
.gemini/skills/
.gemini/agents/
.gemini/commands/
.opencode/skills/
.opencode/agents/
.opencode/commands/
.cursor/rules/00-context.mdc
.agents/
.codex/agents

# Claude Code per-developer local settings (not shared).
.claude/settings.local.json

# OS / editor cruft
.DS_Store

# Demo recording tooling — kept local, not shipped. The rendered docs/imgs/demo.gif that the
# README embeds IS committed; the script and the intermediate asciinema cast are not.
scripts/record-demo.sh
docs/imgs/demo.cast
